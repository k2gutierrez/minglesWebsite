# Optional. Without these values the frontend uses the clearly marked local preview.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Server only: never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Exact site origin, no trailing slash. Set HTTPS production origin when deployed.
APP_ORIGIN=http://localhost:3000
# Public endpoint works for development; use a dedicated ApeChain RPC for production.
APECHAIN_RPC_URL=https://rpc.apechain.com/http
# Collection is configured in src/lib/web3/collection.ts.
# ApeChain 33139 / 0x6579cfd742d8982a7cdc4c00102d3087f6c6dd8e

# ── Rifa ApeFest (sorteo offchain) ───────────────────────────────────────────
# El contrato no usa Chainlink ni vRNG. El owner registra el número ganador con
# setWinner y después retira el pozo. Los compradores pueden salir y recuperar
# su dinero mientras el ganador no esté registrado.
#
# Redes:
#   33111      ApeChain Curtis   → pruebas
#   1          Ethereum mainnet  → producción
#   33139      ApeChain mainnet  → alternativa
#   11155111   Ethereum Sepolia  → opcional
#
# Hoy la página está en Curtis. Para producción cambia a 1 y llena
# NEXT_PUBLIC_RAFFLE_ADDRESS_MAINNET con la dirección del deploy.
NEXT_PUBLIC_RAFFLE_CHAIN_ID=33111

# Dirección por red. La variable específica gana sobre la genérica.
# En Curtis pon la dirección que imprima ./deploy-curtis-owner.sh.
NEXT_PUBLIC_RAFFLE_ADDRESS_CURTIS=
NEXT_PUBLIC_RAFFLE_ADDRESS_MAINNET=
NEXT_PUBLIC_RAFFLE_ADDRESS_SEPOLIA=
NEXT_PUBLIC_RAFFLE_ADDRESS_APECHAIN=

# Compatibilidad con despliegues viejos. Solo se usa en Curtis/ApeChain; nunca
# en Ethereum mainnet, para no apuntar la red equivocada al contrato viejo.
NEXT_PUBLIC_RAFFLE_ADDRESS=

# Ya no se usa para elegir ABI; el contrato es siempre MingleRaffleOwnerDraw.
# Se conserva por compatibilidad con despliegues anteriores.
NEXT_PUBLIC_RAFFLE_KIND=owner
# Enlace de contacto para el ganador (X, Telegram o mailto). Opcional: si está
# vacío, el banner muestra el mensaje sin botón.
NEXT_PUBLIC_WINNER_CONTACT_URL=

# RPC público de la rifa para el navegador (opcional; hay fallback público).
# NUNCA pongas una API key de Alchemy/Infura aquí: NEXT_PUBLIC_* se publica en
# el bundle del navegador. La llave va solo en ETHEREUM_RPC_URL/CURTIS_RPC_URL.
NEXT_PUBLIC_RAFFLE_RPC_URL=

# RPCs que usa el servidor para verificar firmas y leer el contrato.
CURTIS_RPC_URL=https://curtis.rpc.caldera.xyz/http
ETHEREUM_RPC_URL=
SEPOLIA_RPC_URL=
RAFFLE_RPC_URL=
