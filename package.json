{
  "name": "mingles-website",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "format": "prettier --write src docs tests README.md next.config.ts tsconfig.json",
    "verify:contract": "node --env-file-if-exists=.env.local --conditions=react-server --import tsx scripts/verify-contract.ts",
    "check:backend": "node scripts/check-backend.mjs",
    "build:traits": "node scripts/build-mingle-traits.mjs",
    "package:handoff": "node scripts/package-handoff.mjs"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@supabase/supabase-js": "^2.57.0",
    "@tanstack/react-query": "^5.102.8",
    "@x402/core": "2.24.0",
    "@x402/evm": "2.24.0",
    "@x402/extensions": "2.24.0",
    "@x402/svm": "2.24.0",
    "html-to-image": "^1.11.13",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.0",
    "next": "^16.3.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "viem": "^2.56.8",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prettier": "^3.9.8",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "type": "module"
}
